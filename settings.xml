<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for Job Search Copilot.

  Use this when your machine returns "403 Forbidden" for every artifact from
  Maven Central. That means a proxy/firewall (common on corporate networks) is
  intercepting the request, or you must go through an internal mirror.

  HOW TO USE
    Option 1 (global): copy this file to  %USERPROFILE%\.m2\settings.xml
    Option 2 (per-build): mvn -s settings.xml -U clean package

  Then edit the sections below for YOUR network (proxy and/or mirror).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- ============================================================
       1) CORPORATE PROXY
       If your company routes internet through a proxy, uncomment and
       fill in host/port (and username/password if it requires auth).
       Ask your IT team for the values, or check your browser/OS proxy.
       ============================================================ -->
  <!--
  <proxies>
    <proxy>
      <id>corp-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>PROXY_HOST</host>
      <port>PROXY_PORT</port>
      <username>PROXY_USER</username>
      <password>PROXY_PASSWORD</password>
      <nonProxyHosts>localhost|127.0.0.1|*.internal.company.com</nonProxyHosts>
    </proxy>
  </proxies>
  -->

  <!-- ============================================================
       2) MIRROR
       (a) If your company has an internal Nexus/Artifactory, point
           Central at it (ask IT for the URL) — this is usually the
           REAL fix for 403 on corporate networks:

       <mirrors>
         <mirror>
           <id>corp-nexus</id>
           <name>Internal Repo</name>
           <url>https://nexus.company.com/repository/maven-public/</url>
           <mirrorOf>*</mirrorOf>
         </mirror>
       </mirrors>

       (b) If you have NO internal repo and just need plain Central over
           HTTPS (helps if a bad/HTTP mirror was configured somewhere),
           the block below forces the canonical HTTPS Central.
       ============================================================ -->
  <mirrors>
    <mirror>
      <id>central-https</id>
      <name>Maven Central over HTTPS</name>
      <url>https://repo1.maven.org/maven2</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

</settings>
