# ============================================================================
# Job Search Copilot — environment configuration
# Copy this file to `.env` and fill in the values you need.
# ============================================================================

# --- Database ---------------------------------------------------------------
DB_NAME=jobcopilot
DB_USERNAME=jobcopilot
DB_PASSWORD=jobcopilot
DB_ROOT_PASSWORD=rootpassword
DB_PORT=3306

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Security ---------------------------------------------------------------
# MUST be at least 32 bytes (256 bits). Override in production.
JWT_SECRET=change-me-to-a-long-random-256-bit-secret-value-please-override
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!
ADMIN_EMAIL=admin@jobcopilot.local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
# Spring cron (sec min hour day month weekday). Default: every 30 minutes.
SCHEDULER_CRON=0 */30 * * * *

# --- Job providers (enable and configure the ones you use) ------------------
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

JSEARCH_ENABLED=false
JSEARCH_API_KEY=

GREENHOUSE_ENABLED=false
# comma-separated board tokens, e.g. airbnb,stripe
GREENHOUSE_BOARDS=

LEVER_ENABLED=false
# comma-separated company handles, e.g. netflix,leeroy
LEVER_COMPANIES=

# --- Notifications ----------------------------------------------------------
NOTIFY_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFY_EMAIL_TO=

NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Playwright automation (host-side prepare-application) ------------------
BROWSER_PATH=
BROWSER_PROFILE_PATH=
